{
  "name": "agent-sync-layer",
  "version": "0.1.0",
  "description": "CRDT synchronization and Git worktree orchestration for concurrent AI coding agents, including Codex and Claude Code.",
  "private": false,
  "license": "MIT",
  "homepage": "https://github.com/alanoconner/agent-sync-protocol#readme",
  "bugs": {
    "url": "https://github.com/alanoconner/agent-sync-protocol/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alanoconner/agent-sync-protocol.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "codex",
    "claude-code",
    "crdt",
    "yjs",
    "git-worktree",
    "mcp",
    "collaborative-editing",
    "multi-agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./fuse": {
      "types": "./dist/fuse.d.ts",
      "import": "./dist/fuse.js"
    }
  },
  "files": [
    "dist/",
    "docs/asl-cli.md",
    "docs/installation.md",
    "docs/getting-started.md",
    "docs/distribution.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "agent-sync": "dist/cli/index.js",
    "asl": "dist/cli/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:examples": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --esModuleInterop --skipLibCheck examples/claudeCodeHook.ts examples/codexHook.ts",
    "test": "vitest run",
    "build:binary": "node scripts/build-sea.mjs",
    "pack:package": "node scripts/pack-package.mjs",
    "smoke:binary": "node scripts/smoke-binary.mjs",
    "check:release": "node scripts/check-release.mjs",
    "release:check": "npm run check:release && npm run typecheck && npm run typecheck:examples && npm test && npm run verify:package && npm audit --omit=dev",
    "verify:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run release:check",
    "prepack": "npm run clean && npm run build",
    "server": "tsx src/server/index.ts",
    "cli": "tsx src/cli/index.ts",
    "demo": "tsx examples/demoClient.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "js-yaml": "^5.4.1",
    "lib0": "^0.2.94",
    "simple-git": "^3.36.0",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "fuse-native": "^2.2.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/diff": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
